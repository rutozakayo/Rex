# DARKNOTE CONTROL CENTER — environment configuration
# Copy to .env.local for local runs. Never commit real values.

# --- Administrator authentication (required) ---
# scrypt hash of the single administrator password.
# Generate with: node scripts/hash-password.mjs "<password>"
ADMIN_PASSWORD_HASH=
# Session signing secret. 32+ random characters. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- Credential encryption at rest (required to save a panel configuration) ---
# AES-256-GCM key for the stored Pterodactyl API key. 32+ random characters.
# Changing this value invalidates any saved panel credential.
PANEL_ENCRYPTION_KEY=

# --- Connection metadata storage (required in production) ---
# Neon PostgreSQL connection string. Run database/schema.sql once.
DATABASE_URL=

# --- Legacy single-panel fallback (optional) ---
# Optional. Used only when no panel has been saved through the dashboard.
# Once a configuration is saved in the UI, these are ignored.
PTERODACTYL_BASE_URL=
PTERODACTYL_CLIENT_API_TOKEN=
PTERODACTYL_SERVER_ID=
